        "patch": "diff --git a/packages/core/src/util/lazy.ts b/packages/core/src/util/lazy.ts\nindex 935ebe0f9..ce9cab18c 100644\n--- a/packages/core/src/util/lazy.ts\n+++ b/packages/core/src/util/lazy.ts\n@@ -4,8 +4,8 @@ export function lazy<T>(fn: () => T) {\n \n   return (): T => {\n     if (loaded) return value as T\n-    loaded = true\n     value = fn()\n+    loaded = true\n     return value as T\n   }\n }\n\ndiff --git a/packages/core/test/util/lazy.test.ts b/packages/core/test/util/lazy.test.ts\nnew file mode 100644\nindex 000000000..7dc9fc345\n--- /dev/null\n+++ b/packages/core/test/util/lazy.test.ts\n@@ -0,0 +1,20 @@\n+import { describe, expect, test } from \"bun:test\"\n+import { lazy } from \"../../src/util/lazy\"\n+\n+describe(\"util.lazy\", () => {\n+  test(\"retries after a throw and caches the first successful value\", () => {\n+    let attempts = 0\n+    const get = lazy(() => {\n+      attempts++\n+      if (attempts === 1) throw new Error(\"not ready\")\n+      return { ready: true }\n+    })\n+\n+    expect(() => get()).toThrow(\"not ready\")\n+    const value = get()\n+\n+    expect(value).toEqual({ ready: true })\n+    expect(get()).toBe(value)\n+    expect(attempts).toBe(2)\n+  })\n+})\n",
