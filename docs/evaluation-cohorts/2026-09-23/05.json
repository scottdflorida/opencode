        "patch": "diff --git a/packages/opencode/src/util/queue.ts b/packages/opencode/src/util/queue.ts\nindex a1af53fe8..0bc213823 100644\n--- a/packages/opencode/src/util/queue.ts\n+++ b/packages/opencode/src/util/queue.ts\n@@ -19,11 +19,12 @@ export class AsyncQueue<T> implements AsyncIterable<T> {\n }\n \n export async function work<T>(concurrency: number, items: T[], fn: (item: T) => Promise<void>) {\n+  if (concurrency < 1) throw new RangeError(\"Concurrency must be at least 1\")\n   const pending = [...items]\n   await Promise.all(\n     Array.from({ length: concurrency }, async () => {\n       while (true) {\n-        const item = pending.pop()\n+        const item = pending.shift()\n         if (item === undefined) return\n         await fn(item)\n       }\n\ndiff --git a/packages/opencode/test/util/queue.test.ts b/packages/opencode/test/util/queue.test.ts\nnew file mode 100644\nindex 000000000..d4758c922\n--- /dev/null\n+++ b/packages/opencode/test/util/queue.test.ts\n@@ -0,0 +1,18 @@\n+import { describe, expect, test } from \"bun:test\"\n+import { work } from \"@/util/queue\"\n+\n+describe(\"work\", () => {\n+  test(\"processes items in input order with concurrency one\", async () => {\n+    const seen: number[] = []\n+\n+    await work(1, [1, 2, 3], async (item) => {\n+      seen.push(item)\n+    })\n+\n+    expect(seen).toEqual([1, 2, 3])\n+  })\n+\n+  test(\"rejects concurrency below one\", async () => {\n+    await expect(work(0, [1], async () => {})).rejects.toThrow(\"Concurrency must be at least 1\")\n+  })\n+})\n",
